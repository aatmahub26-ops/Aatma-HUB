import { MetadataRoute } from 'next'

/**
 * @fileOverview PWA Manifest Intelligence
 * Configures the platform for standalone mobile installation.
 */

export default function manifest(): MetadataRoute.Manifest {
  return {
    name: 'Aatma HUB 2.0',
    short_name: 'Aatma HUB',
    description: 'Premier Esports Marketplace & Instant Top-ups',
    start_url: '/',
    display: 'standalone',
    background_color: '#0B0B0F',
    theme_color: '#9E66FF',
    icons: [
      {
        src: '/icon-192.png',
        sizes: '192x192',
        type: 'image/png',
      },
      {
        src: '/icon-512.png',
        sizes: '512x512',
        type: 'image/png',
      },
    ],
  }
}
